{
  "target": {
    "type": "powershell",
    "prompt": "PS C:\\demo> ",
    "url": "https://opcp-psmc.com:6124/oracle",
    "input_selectors": [
      "textarea",
      "input[type=text]",
      "input:not([type])",
      "[contenteditable=true]"
    ],
    "send_selector": "",
    "answer_selector": ".message.assistant",
    "ignore_https_errors": true,
    "cwd": ".",
    "title": "",
    "font_size": 16
  },
  "timing": {
    "typing_delay_ms": 45,
    "pause_after_step": 3,
    "max_wait_per_answer": 120,
    "answer_stable_for": 4,
    "manual_timeout": 600
  },
  "output": {
    "name": "demo-openstack",
    "width": 1280,
    "height": 720,
    "mp4": true,
    "gif": true,
    "gif_speed": 2.0,
    "gif_fps": 10,
    "gif_width": 960,
    "delete_raw": true,
    "browser_path": "C:\\Program Files\\Chromium\\Application\\chrome.exe"
  },
  "steps": [
    {
      "type": "run",
      "command": ". .\\venv\\Scripts\\Activate.ps1; . .\\creds-openstack.ps1",
      "timeout": 300,
      "hide": true
    },
    {
      "type": "run",
      "command": "openstack --version",
      "timeout": 300,
      "hide": false
    },
    {
      "type": "run",
      "command": "openstack server list",
      "timeout": 300,
      "hide": false
    },
    {
      "type": "run",
      "command": "openstack network list",
      "timeout": 300,
      "hide": false
    },
    {
      "type": "run",
      "command": "openstack baremetal node list",
      "timeout": 300,
      "hide": false
    }
  ]
}